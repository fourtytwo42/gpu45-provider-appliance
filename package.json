{
  "name": "gpu45-provider-appliance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --config prisma.config.ts && next build --webpack && node scripts/prepare-standalone.mjs",
    "start": "next start",
    "worker": "tsx src/worker.ts",
    "lint": "eslint",
    "pretest": "prisma generate --config prisma.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "qa": "npm run lint && npm run test && npm run test:e2e",
    "typecheck": "prisma generate --config prisma.config.ts && tsc --noEmit",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:push": "tsx src/scripts/init-db.ts",
    "db:studio": "prisma studio --config prisma.config.ts",
    "release:deploy": "sudo bash scripts/deploy-release.sh",
    "admin:create": "tsx src/scripts/create-admin.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@mozilla/readability": "^0.6.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/ssh2": "^1.15.5",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "recharts": "^3.9.0",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "postcss": "8.5.10"
  }
}

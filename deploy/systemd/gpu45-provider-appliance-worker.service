[Unit]
Description=GPU45 provider appliance collector worker
After=network-online.target gpu45-host-tune.service
Wants=network-online.target

[Service]
Type=simple
User=gpu45
Group=gpu45
SupplementaryGroups=hendo420 video render
WorkingDirectory=/opt/gpu45/current
EnvironmentFile=-/etc/gpu45/appliance.env
EnvironmentFile=-/etc/gpu45/release.env
ExecStart=/opt/gpu45/current/node_modules/.bin/tsx src/worker.ts
Restart=always
RestartSec=5
TimeoutStartSec=120
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=false
MemoryHigh=1G
MemoryMax=2G

[Install]
WantedBy=multi-user.target

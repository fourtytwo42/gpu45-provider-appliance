[Unit]
Description=GPU45 provider appliance console on port %i
After=network-online.target gpu45-host-tune.service
Wants=network-online.target

[Service]
Type=simple
User=gpu45
Group=gpu45
SupplementaryGroups=hendo420 video render
WorkingDirectory=/opt/gpu45/slots/%i/.next/standalone
EnvironmentFile=-/etc/gpu45/appliance.env
EnvironmentFile=-/etc/gpu45/release.env
Environment=PORT=%i
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=15
KillMode=control-group
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=false
MemoryHigh=1G
MemoryMax=2G

[Install]
WantedBy=multi-user.target

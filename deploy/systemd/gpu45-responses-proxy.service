[Unit]
Description=GPU45 Responses API compatibility proxy
After=network-online.target gpu45-host-tune.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/gpu45/resource-manager.env
Environment=PYTHONPATH=/opt/gpu45/current/services/common
Environment=GPU45_DB_PATH=/var/lib/gpu45/appliance.db
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/gpu45-responses-proxy
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

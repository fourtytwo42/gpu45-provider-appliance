[Unit]
Description=GPU45 provider appliance console
After=network-online.target gpu45-host-tune.service llama-openai.service
Wants=network-online.target llama-openai.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/gpu45/current
EnvironmentFile=-/etc/gpu45/appliance.env
EnvironmentFile=-/etc/gpu45/release.env
ExecStartPre=/usr/bin/npm run db:push
ExecStart=/usr/bin/npm run start -- --port 3010 -H 0.0.0.0
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target

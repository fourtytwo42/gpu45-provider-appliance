[Unit]
Description=GPU45 provider appliance console
After=network-online.target gpu45-host-tune.service
Wants=network-online.target

[Service]
Type=simple
User=gpu45
Group=gpu45
SupplementaryGroups=hendo420 video render
WorkingDirectory=/opt/gpu45/current
EnvironmentFile=-/etc/gpu45/appliance.env
EnvironmentFile=-/etc/gpu45/release.env
ExecStartPre=/usr/bin/npm run db:push
ExecStart=/usr/bin/npm run start -- --port 3010 -H 127.0.0.1
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=15
KillMode=control-group
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target

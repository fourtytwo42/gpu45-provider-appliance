[Unit]
Description=GPU45 host tuning
After=local-fs.target
Before=llama-openai.service gpu45-v620-fan-controller.service gpu45-provider-appliance.service gpu45-provider-appliance-worker.service gpu45-responses-proxy.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/gpu45-host-tune.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

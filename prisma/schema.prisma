generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model MetricSample {
  id         String   @id @default(cuid())
  kind       String
  series     String
  value      Float
  unit       String
  capturedAt DateTime @default(now())

  @@index([kind, capturedAt])
}

model ProviderState {
  id              String   @id @default(cuid())
  status          String
  model           String
  activeRequests  Int
  promptTokens    Int
  completionTokens Int
  tokensPerSecond Float
  providerUrl     String
  lastError       String?
  capturedAt      DateTime @default(now())

  @@index([capturedAt])
}

model ModelAsset {
  id             String   @id @default(cuid())
  name           String
  path           String
  repo           String?
  revision       String?
  sizeBytes      BigInt
  multimodal     Boolean  @default(false)
  projectorPath  String?
  draftPath      String?
  active         Boolean  @default(false)
  served         Boolean  @default(false)
  servedAlias    String?  @unique
  defaultModel   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
  @@unique([path])
}

model ApiKey {
  id               String   @id @default(cuid())
  name             String?
  keyHash          String   @unique
  keyPrefix        String
  expiresAt        DateTime?
  suspendedAt      DateTime?
  lastUsedAt       DateTime?
  requestCount     Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  createdAt        DateTime @default(now())
  usage            ApiKeyUsage[]
}

model ApiKeyUsage {
  id               String   @id @default(cuid())
  apiKeyId         String?
  apiKey           ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  model            String
  requestedModel   String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  statusCode       Int
  createdAt        DateTime @default(now())

  @@index([apiKeyId, createdAt])
  @@index([model, createdAt])
}

model EndpointSetting {
  id             String   @id @default("default")
  allowAnonymous Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model MetricMinute {
  id        String   @id @default(cuid())
  kind      String
  series    String
  average   Float
  minimum   Float
  maximum   Float
  samples   Int
  unit      String
  bucketAt  DateTime

  @@unique([kind, series, bucketAt])
  @@index([kind, bucketAt])
}

model MetricHour {
  id        String   @id @default(cuid())
  kind      String
  series    String
  average   Float
  minimum   Float
  maximum   Float
  samples   Int
  unit      String
  bucketAt  DateTime

  @@unique([kind, series, bucketAt])
  @@index([kind, bucketAt])
}

model AdminUser {
  id             String         @id @default(cuid())
  username       String         @unique
  passwordHash   String
  passwordSalt   String
  failedAttempts Int            @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  sessions       AdminSession[]
}

model AdminSession {
  id         String    @id
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfToken  String
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model LaunchProfile {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  modelPath    String
  mmprojPath   String?
  modelDraftPath String?
  host         String   @default("0.0.0.0")
  port         Int      @default(30000)
  ctxSize      Int      @default(262144)
  gpuLayers    String   @default("all")
  batchSize    Int      @default(2048)
  uBatchSize   Int      @default(512)
  cacheRamMiB  Int      @default(8192)
  cacheTypeK   String   @default("q4_0")
  cacheTypeV   String   @default("q4_0")
  cacheReuse   Int      @default(1024)
  specType     String   @default("draft-mtp")
  specDraftNMax Int     @default(2)
  flashAttention String @default("on")
  imageMinTokens Int     @default(1024)
  metrics      Boolean  @default(true)
  jinja        Boolean  @default(true)
  active       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FanCurveProfile {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  pointsJson   String
  active       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BenchmarkRun {
  id                     String   @id @default(cuid())
  modelName              String
  prompt                 String
  totalTokens            Int
  promptTokens           Int
  completionTokens       Int
  promptTokensPerSecond  Float
  generationTokensPerSecond Float
  durationMs             Int
  peakGpuTempC           Float?
  peakVramBytes          BigInt?
  notes                  String?
  optionsJson            String?
  createdAt              DateTime @default(now())
}

model DownloadJob {
  id              String   @id @default(cuid())
  repoId          String
  fileName        String
  revision        String   @default("main")
  status          String   @default("queued")
  bytesDownloaded BigInt   @default(0)
  totalBytes      BigInt   @default(0)
  targetPath      String
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  subject    String
  details    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}


model WebSearchRun {
  id          String   @id @default(cuid())
  query       String
  category    String   @default("general")
  resultCount Int      @default(0)
  status      String   @default("completed")
  error       String?
  createdAt   DateTime @default(now())
  results     WebSearchResult[]

  @@index([createdAt])
}

model WebSearchResult {
  id             String       @id @default(cuid())
  runId          String
  run            WebSearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  title          String
  url            String
  snippet        String       @default("")
  engine         String       @default("searxng")
  rank           Int
  officialSource Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([runId, rank])
  @@index([url])
}

model WebPageCache {
  id            String   @id @default(cuid())
  url           String
  finalUrl      String
  statusCode    Int
  contentType   String
  fetchedAt     DateTime @default(now())
  title         String   @default("")
  text          String   @default("")
  linksJson     String   @default("[]")
  robotsAllowed Boolean  @default(true)
  renderMode    String   @default("static")

  @@index([url, fetchedAt])
}

model JobLead {
  id            String   @id @default(cuid())
  sourceUrl     String
  company       String   @default("")
  title         String   @default("")
  location      String   @default("")
  remoteStatus  String   @default("unknown")
  applyUrl      String   @default("")
  atsType       String?
  confidence    Float    @default(0)
  extractedJson String   @default("{}")
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([sourceUrl])
}

